# Application Server Configuration
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/link_expiry?schema=public"

# Redis Cache & Fast-path Expiration
# Format: redis://<host>:<port> or rediss://<host>:<port> for TLS
REDIS_URL="redis://localhost:6379"

# Allowed CORS Origins (comma-separated list for multiple domains)
FRONTEND_URL="https://link-expiry-ui.vercel.app,http://localhost:5173"
